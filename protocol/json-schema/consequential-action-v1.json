{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://balanceframe.dev/schemas/consequential-action-v1.json",
  "title": "BalanceFrame Consequential Action v1",
  "description": "Native-derived exact action plans and verification requests. JSON Schema cannot prove that splits conserve their debit, that a reallocation selects a safe Decision Card path, that an evidence projection exactly matches its source-normalized ledger effect, or that postconditions match the synchronized ledger; those checks remain native-owned.",
  "$ref": "#/$defs/PlanConsequentialActionRequest",
  "$defs": {
    "String": { "type": "string", "minLength": 1 },
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "Month": { "type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$" },
    "Date": { "$ref": "https://balanceframe.dev/schemas/financial-snapshot-v1.json#/$defs/CanonicalDate" },
    "Timestamp": { "$ref": "https://balanceframe.dev/schemas/financial-snapshot-v1.json#/$defs/CanonicalUtcTimestamp" },
    "Money": { "$ref": "https://balanceframe.dev/schemas/financial-snapshot-v1.json#/$defs/Money" },
    "DecisionCardRequest": { "$ref": "https://balanceframe.dev/schemas/decision-card-v1.json#/$defs/DecisionCardRequest" },
    "PositiveMoney": {
      "allOf": [
        { "$ref": "#/$defs/Money" },
        { "properties": { "minorUnits": { "not": { "const": "0" }, "pattern": "^[1-9][0-9]*$" } } }
      ]
    },
    "ManualTransactionSplit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["categoryId", "amount"],
      "properties": {
        "categoryId": { "$ref": "#/$defs/String" },
        "amount": { "$ref": "#/$defs/Money" }
      }
    },
    "ManualTransactionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parentId", "correlationId", "accountId", "amount", "date", "categoryId", "payeeName", "notes", "splits"],
      "properties": {
        "parentId": { "$ref": "#/$defs/String" },
        "correlationId": { "$ref": "#/$defs/String" },
        "accountId": { "$ref": "#/$defs/String" },
        "amount": { "$ref": "#/$defs/Money" },
        "date": { "$ref": "#/$defs/Date" },
        "categoryId": { "type": ["string", "null"], "minLength": 1 },
        "payeeName": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] },
        "splits": { "type": "array", "items": { "$ref": "#/$defs/ManualTransactionSplit" } }
      }
    },
    "ReallocationAssignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCategoryId", "sourceAsOfMonth", "destinationCategoryId", "destinationAsOfMonth", "amount"],
      "properties": {
        "sourceCategoryId": { "$ref": "#/$defs/String" },
        "sourceAsOfMonth": { "$ref": "#/$defs/Month" },
        "destinationCategoryId": { "$ref": "#/$defs/String" },
        "destinationAsOfMonth": { "$ref": "#/$defs/Month" },
        "amount": { "$ref": "#/$defs/PositiveMoney" }
      }
    },
    "AtomicConsequentialActionIntent": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "assignments"],
          "properties": { "kind": { "const": "reallocation" }, "assignments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ReallocationAssignment" } } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "transaction"],
          "properties": { "kind": { "const": "manual_transaction" }, "transaction": { "$ref": "#/$defs/ManualTransactionIntent" } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "transaction", "evidenceIds"],
          "properties": { "kind": { "const": "evidence_projection" }, "transaction": { "$ref": "#/$defs/ManualTransactionIntent" }, "evidenceIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/String" }, "uniqueItems": true } }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "walletId", "accountName", "currency"],
          "properties": { "kind": { "const": "wallet_materialization" }, "walletId": { "$ref": "#/$defs/String" }, "accountName": { "$ref": "#/$defs/String" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "transferId", "correlationId", "sourceAccountId", "destinationAccountId", "amount", "date"],
          "properties": {
            "kind": { "const": "transfer" },
            "transferId": { "$ref": "#/$defs/String" },
            "correlationId": { "$ref": "#/$defs/String" },
            "sourceAccountId": { "$ref": "#/$defs/String" },
            "destinationAccountId": { "$ref": "#/$defs/String" },
            "amount": { "$ref": "#/$defs/PositiveMoney" },
            "date": { "$ref": "#/$defs/Date" }
          }
        }
      ]
    },
    "ConsequentialActionIntent": {
      "oneOf": [
        { "$ref": "#/$defs/AtomicConsequentialActionIntent" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "actions"],
          "properties": { "kind": { "const": "composite" }, "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/AtomicConsequentialActionIntent" } } }
        }
      ]
    },
    "ConsequentialActionAccount": {
      "type": "object", "additionalProperties": false,
      "required": ["accountId", "name", "onBudget", "closed", "currency", "balance"],
      "properties": { "accountId": { "$ref": "#/$defs/String" }, "name": { "$ref": "#/$defs/String" }, "onBudget": { "type": "boolean" }, "closed": { "type": "boolean" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }, "balance": { "$ref": "#/$defs/Money" } }
    },
    "ConsequentialActionCategory": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryId"], "properties": { "categoryId": { "$ref": "#/$defs/String" } }
    },
    "ConsequentialActionAssignment": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryId", "asOfMonth", "amount"],
      "properties": { "categoryId": { "$ref": "#/$defs/String" }, "asOfMonth": { "$ref": "#/$defs/Month" }, "amount": { "$ref": "#/$defs/Money" } }
    },
    "WalletMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["walletId", "accountId"], "properties": { "walletId": { "$ref": "#/$defs/String" }, "accountId": { "$ref": "#/$defs/String" } }
    },
    "LedgerTransaction": {
      "type": "object", "additionalProperties": false,
      "required": ["parentId", "accountId", "amount", "date", "categoryId", "payeeName", "notes", "splits", "transferAccountId"],
      "properties": { "parentId": { "$ref": "#/$defs/String" }, "accountId": { "$ref": "#/$defs/String" }, "amount": { "$ref": "#/$defs/Money" }, "date": { "$ref": "#/$defs/Date" }, "categoryId": { "type": ["string", "null"], "minLength": 1 }, "payeeName": { "type": ["string", "null"] }, "notes": { "type": ["string", "null"] }, "splits": { "type": "array", "items": { "$ref": "#/$defs/ManualTransactionSplit" } }, "transferAccountId": { "type": ["string", "null"], "minLength": 1 } }
    },
    "TransferMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["transferId", "correlationId", "marker", "sourceTransactionId", "destinationTransactionId", "sourceAccountId", "destinationAccountId", "amount", "date"],
      "properties": { "transferId": { "$ref": "#/$defs/String" }, "correlationId": { "$ref": "#/$defs/String" }, "marker": { "$ref": "#/$defs/String" }, "sourceTransactionId": { "$ref": "#/$defs/String" }, "destinationTransactionId": { "$ref": "#/$defs/String" }, "sourceAccountId": { "$ref": "#/$defs/String" }, "destinationAccountId": { "$ref": "#/$defs/String" }, "amount": { "$ref": "#/$defs/PositiveMoney" }, "date": { "$ref": "#/$defs/Date" } }
    },
    "ConsequentialActionLedger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounts", "categories", "assignments", "wallets", "transactions", "transfers"],
      "properties": {
        "accounts": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionAccount" } },
        "categories": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionCategory" } },
        "assignments": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionAssignment" } },
        "wallets": { "type": "array", "items": { "$ref": "#/$defs/WalletMapping" } },
        "transactions": { "type": "array", "items": { "$ref": "#/$defs/LedgerTransaction" } },
        "transfers": { "type": "array", "items": { "$ref": "#/$defs/TransferMapping" } }
      }
    },
    "ConsequentialActionEvidence": {
      "type": "object", "additionalProperties": false,
      "required": ["evidenceId", "subjectId", "state", "contentHash"],
      "properties": { "evidenceId": { "$ref": "#/$defs/String" }, "subjectId": { "$ref": "#/$defs/String" }, "state": { "enum": ["resolved", "stale", "missing"] }, "contentHash": { "type": ["string", "null"], "minLength": 1 }, "version": { "$ref": "#/$defs/String" } }
    },
    "PlanConsequentialActionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["decisionCardRequest", "intent", "currentLedger", "resolvedEvidence", "financialPolicyVersion", "evaluatedAt", "idempotencyKey", "supplementalObservations"],
      "properties": { "decisionCardRequest": { "$ref": "#/$defs/DecisionCardRequest" }, "intent": { "$ref": "#/$defs/ConsequentialActionIntent" }, "currentLedger": { "$ref": "#/$defs/ConsequentialActionLedger" }, "resolvedEvidence": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionEvidence" } }, "financialPolicyVersion": { "$ref": "#/$defs/String" }, "evaluatedAt": { "$ref": "#/$defs/Timestamp" }, "idempotencyKey": { "$ref": "#/$defs/String" }, "supplementalObservations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionSupplementalObservation" } } }
    },
    "ConsequentialActionSupplementalField": { "enum": ["currency", "kind", "owned", "currentLedgerConfirmed", "holds", "unsettledFlows", "obligations", "credit"] },
    "ConsequentialActionSupplementalFactPath": { "enum": ["currency", "currencyEvidence", "kind", "kindEvidence", "owned", "ownershipEvidence", "freshnessEvidence", "holds", "holdsEvidence", "activityEvidence", "scheduleEvidence", "credit"] },
    "ConsequentialActionSupplementalObservation": {
      "type": "object", "additionalProperties": false,
      "required": ["accountId", "fields", "flowIds", "obligationIds"],
      "properties": { "accountId": { "$ref": "#/$defs/String" }, "fields": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionSupplementalField" } }, "flowIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/String" } }, "obligationIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/String" } } }
    },
    "ConsequentialActionInvalidatedSupplementalFacts": {
      "type": "object", "additionalProperties": false,
      "required": ["accountId", "fields", "paths", "flowIds", "obligationIds"],
      "properties": { "accountId": { "$ref": "#/$defs/String" }, "fields": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionSupplementalField" } }, "paths": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionSupplementalFactPath" } }, "flowIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/String" } }, "obligationIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/String" } } }
    },
    "ConsequentialActionSource": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "contentHash", "policyVersion", "claimSetRevision", "financialPolicyVersion", "evidenceHash", "invalidatedFreshnessAccounts", "manualPayeeBindings", "invalidatedSupplementalFacts", "accountsCoverageBefore", "transactionsCoverageBefore", "preconditionsHash", "invariantsHash"],
      "properties": { "snapshotId": { "$ref": "#/$defs/String" }, "contentHash": { "$ref": "#/$defs/String" }, "policyVersion": { "$ref": "#/$defs/String" }, "claimSetRevision": { "$ref": "#/$defs/String" }, "financialPolicyVersion": { "$ref": "#/$defs/String" }, "evidenceHash": { "$ref": "#/$defs/Hash" }, "invalidatedFreshnessAccounts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/String" } }, "manualPayeeBindings": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionManualPayeeBinding" } }, "invalidatedSupplementalFacts": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionInvalidatedSupplementalFacts" } }, "accountsCoverageBefore": { "enum": ["complete", "empty", "partial", "unknown", "unavailable"] }, "transactionsCoverageBefore": { "enum": ["complete", "empty", "partial", "unknown", "unavailable"] }, "preconditionsHash": { "$ref": "#/$defs/Hash" }, "invariantsHash": { "$ref": "#/$defs/Hash" } }
    },
    "ConsequentialActionManualPayeeBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["parentId", "payeeName", "existingPayeeId"],
      "properties": { "parentId": { "$ref": "#/$defs/String" }, "payeeName": { "$ref": "#/$defs/String" }, "existingPayeeId": { "anyOf": [{ "$ref": "#/$defs/String" }, { "type": "null" }] } }
    },
    "ConsequentialActionAccountBalancePrecondition": {
      "type": "object", "additionalProperties": false,
      "required": ["accountId", "balance"],
      "properties": { "accountId": { "$ref": "#/$defs/String" }, "balance": { "$ref": "#/$defs/Money" } }
    },
    "ConsequentialActionAssignmentPrecondition": {
      "type": "object", "additionalProperties": false,
      "required": ["categoryId", "asOfMonth", "amount", "postAmount"],
      "properties": { "categoryId": { "$ref": "#/$defs/String" }, "asOfMonth": { "$ref": "#/$defs/Month" }, "amount": { "$ref": "#/$defs/Money" }, "postAmount": { "$ref": "#/$defs/Money" } }
    },
    "ConsequentialActionDispatchPrecondition": {
      "type": "object", "additionalProperties": false,
      "required": ["atomIndex", "accountBalances", "assignments"],
      "properties": { "atomIndex": { "type": "integer", "minimum": 0 }, "accountBalances": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionAccountBalancePrecondition" } }, "assignments": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ConsequentialActionAssignmentPrecondition" } } }
    },
    "ReasonCode": { "enum": ["safe_reallocation", "account_readiness", "payment_route", "transfer_need", "reservation_commitment", "evidence_resolution"] },
    "ReadinessState": { "enum": ["ready", "blocked"] },
    "Impact": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "sourceCategoryId", "sourceAsOfMonth", "destinationCategoryId", "destinationAsOfMonth", "amount", "sourceProtected", "sourceAvailabilityBefore", "sourceAvailabilityAfter", "sourceUncommittedAvailabilityBefore", "sourceUncommittedAvailabilityAfter", "minimumRetained", "projectedRemainingNeed", "safeToRedirectAfter", "rationale"], "properties": { "kind": { "const": "category_reallocation" }, "sourceCategoryId": { "$ref": "#/$defs/String" }, "sourceAsOfMonth": { "$ref": "#/$defs/Month" }, "destinationCategoryId": { "$ref": "#/$defs/String" }, "destinationAsOfMonth": { "$ref": "#/$defs/Month" }, "amount": { "$ref": "#/$defs/PositiveMoney" }, "sourceProtected": { "type": "boolean" }, "sourceAvailabilityBefore": { "$ref": "#/$defs/Money" }, "sourceAvailabilityAfter": { "$ref": "#/$defs/Money" }, "sourceUncommittedAvailabilityBefore": { "$ref": "#/$defs/Money" }, "sourceUncommittedAvailabilityAfter": { "$ref": "#/$defs/Money" }, "minimumRetained": { "$ref": "#/$defs/Money" }, "projectedRemainingNeed": { "$ref": "#/$defs/Money" }, "safeToRedirectAfter": { "$ref": "#/$defs/Money" }, "rationale": { "const": "donor_category_surplus_redirected" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "accountId", "state"], "properties": { "kind": { "const": "account_readiness" }, "accountId": { "$ref": "#/$defs/String" }, "state": { "$ref": "#/$defs/ReadinessState" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "accountId", "state"], "properties": { "kind": { "const": "payment_route" }, "accountId": { "$ref": "#/$defs/String" }, "state": { "$ref": "#/$defs/ReadinessState" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "accountId", "amount"], "properties": { "kind": { "const": "transfer_need" }, "accountId": { "$ref": "#/$defs/String" }, "amount": { "$ref": "#/$defs/PositiveMoney" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "categoryId", "commitments", "reservations"], "properties": { "kind": { "const": "reservation_commitment" }, "categoryId": { "$ref": "#/$defs/String" }, "commitments": { "$ref": "#/$defs/Money" }, "reservations": { "$ref": "#/$defs/Money" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "evidenceId", "state"], "properties": { "kind": { "const": "evidence_resolution" }, "evidenceId": { "$ref": "#/$defs/String" }, "state": { "const": "resolved" } } }
      ]
    },
    "Postcondition": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "categoryId", "asOfMonth", "amount"], "properties": { "kind": { "const": "assignment" }, "categoryId": { "$ref": "#/$defs/String" }, "asOfMonth": { "$ref": "#/$defs/Month" }, "amount": { "$ref": "#/$defs/Money" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "accountId", "balance"], "properties": { "kind": { "const": "account_balance" }, "accountId": { "$ref": "#/$defs/String" }, "balance": { "$ref": "#/$defs/Money" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "parentId", "accountId", "amount", "date", "categoryId", "payeeName", "notes", "splits"], "properties": { "kind": { "const": "transaction" }, "parentId": { "$ref": "#/$defs/String" }, "accountId": { "$ref": "#/$defs/String" }, "amount": { "$ref": "#/$defs/Money" }, "date": { "$ref": "#/$defs/Date" }, "categoryId": { "type": ["string", "null"], "minLength": 1 }, "payeeName": { "type": ["string", "null"] }, "notes": { "type": ["string", "null"] }, "splits": { "type": "array", "items": { "$ref": "#/$defs/ManualTransactionSplit" } } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "walletId", "accountName", "onBudget", "closed", "openingBalance"], "properties": { "kind": { "const": "wallet_mapping" }, "walletId": { "$ref": "#/$defs/String" }, "accountName": { "$ref": "#/$defs/String" }, "onBudget": { "const": true }, "closed": { "const": false }, "openingBalance": { "$ref": "#/$defs/Money" } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "transferId", "correlationId", "sourceAccountId", "destinationAccountId", "amount", "date"], "properties": { "kind": { "const": "transfer_ledger_entry" }, "transferId": { "$ref": "#/$defs/String" }, "correlationId": { "$ref": "#/$defs/String" }, "sourceAccountId": { "$ref": "#/$defs/String" }, "destinationAccountId": { "$ref": "#/$defs/String" }, "amount": { "$ref": "#/$defs/PositiveMoney" }, "date": { "$ref": "#/$defs/Date" } } }
      ]
    },
    "ConsequentialActionPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "action", "source", "evidenceReferences", "expiresAt", "idempotencyKey", "reasonCodes", "impacts", "expectedPostconditions", "dispatchPreconditions", "actionHash"],
      "properties": { "version": { "const": "1" }, "action": { "$ref": "#/$defs/ConsequentialActionIntent" }, "source": { "$ref": "#/$defs/ConsequentialActionSource" }, "evidenceReferences": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionEvidence" } }, "expiresAt": { "$ref": "#/$defs/Timestamp" }, "idempotencyKey": { "$ref": "#/$defs/String" }, "reasonCodes": { "type": "array", "items": { "$ref": "#/$defs/ReasonCode" }, "uniqueItems": true }, "impacts": { "type": "array", "items": { "$ref": "#/$defs/Impact" } }, "expectedPostconditions": { "type": "array", "items": { "$ref": "#/$defs/Postcondition" } }, "dispatchPreconditions": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionDispatchPrecondition" } }, "actionHash": { "$ref": "#/$defs/Hash" } }
    },
    "VerifyConsequentialActionRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["plan", "phase", "decisionCardRequest", "currentLedger", "resolvedEvidence", "evaluatedAt", "financialPolicyVersion"],
      "properties": { "plan": { "$ref": "#/$defs/ConsequentialActionPlan" }, "phase": { "enum": ["preconditions", "postconditions"] }, "decisionCardRequest": { "$ref": "#/$defs/DecisionCardRequest" }, "currentLedger": { "$ref": "#/$defs/ConsequentialActionLedger" }, "resolvedEvidence": { "type": "array", "items": { "$ref": "#/$defs/ConsequentialActionEvidence" } }, "evaluatedAt": { "$ref": "#/$defs/Timestamp" }, "financialPolicyVersion": { "$ref": "#/$defs/String" } }
    },
    "ConsequentialActionVerification": {
      "type": "object", "additionalProperties": false,
      "required": ["valid", "reason", "actionHash"],
      "properties": { "valid": { "type": "boolean" }, "reason": { "type": ["string", "null"], "enum": ["expired", "source_changed", "evidence_changed", "policy_changed", "claims_changed", "target_changed", "postcondition_mismatch", "invalid_plan", null] }, "actionHash": { "$ref": "#/$defs/Hash" } }
    }
  }
}
