{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://balanceframe.dev/schemas/prospective-decision-v1.json",
  "title": "BalanceFrame Prospective Purchase Decision v1",
  "description": "Typed prospective purchase decision with immutable context, semantic states, issues, evidence references, and legacy-compatible PurchaseEvaluation payload.",
  "$ref": "#/$defs/PurchaseProspectiveDecisionEnvelope",
  "$defs": {
    "CanonicalUtcTimestamp": {
      "type": "string",
      "pattern": "^(?:(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29|[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8])))T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minorUnits", "currency"],
      "properties": {
        "minorUnits": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]{0,17}|(?:[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)|-(?:[1-9][0-9]{0,17}|(?:[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-7]|9223372036854775808)))$"
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "DecisionScope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "global" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "enum": ["account", "category", "transaction", "schedule", "claim"] },
            "id": { "type": "string" }
          }
        }
      ]
    },
    "EvidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "kind", "authorized", "redaction"],
      "properties": {
        "evidenceId": { "type": "string" },
        "kind": { "type": "string" },
        "authorized": { "type": "boolean" },
        "redaction": { "enum": ["visible", "redacted"] }
      }
    },
    "Remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "action"],
      "properties": {
        "code": { "type": "string" },
        "action": { "type": "string" }
      }
    },
    "DecisionIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "effect", "scope", "evidence", "redaction"],
      "properties": {
        "code": { "type": "string" },
        "severity": { "enum": ["info", "warning", "critical"] },
        "effect": { "enum": ["qualifies", "blocks"] },
        "scope": { "$ref": "#/$defs/DecisionScope" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceReference" } },
        "remediation": {
          "anyOf": [{ "$ref": "#/$defs/Remediation" }, { "type": "null" }]
        },
        "redaction": { "enum": ["visible", "redacted"] }
      }
    },
    "AccountOverrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includeOnly", "exclude"],
      "properties": {
        "includeOnly": {
          "anyOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }]
        },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DecisionDataPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pendingMode",
        "uncategorizedMode",
        "unclearedMode",
        "maxBankSyncAgeMinutes",
        "maxBudgetSnapshotAgeMinutes",
        "accountOverrides"
      ],
      "properties": {
        "pendingMode": { "enum": ["include", "exclude", "includeConservatively"] },
        "uncategorizedMode": { "enum": ["block", "reserveFullAmount", "ignore"] },
        "unclearedMode": { "enum": ["include", "exclude"] },
        "maxBankSyncAgeMinutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "maxBudgetSnapshotAgeMinutes": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "accountOverrides": { "$ref": "#/$defs/AccountOverrides" }
      }
    },
    "DecisionHorizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/CanonicalUtcTimestamp" },
        "endsAt": { "$ref": "#/$defs/CanonicalUtcTimestamp" }
      }
    },
    "DecisionContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluatedAt",
        "horizon",
        "policy",
        "policyVersion",
        "policyHash",
        "snapshotId",
        "contentHash"
      ],
      "properties": {
        "evaluatedAt": { "$ref": "#/$defs/CanonicalUtcTimestamp" },
        "horizon": { "$ref": "#/$defs/DecisionHorizon" },
        "policy": { "$ref": "#/$defs/DecisionDataPolicy" },
        "policyVersion": { "type": "string" },
        "policyHash": { "type": "string" },
        "snapshotId": { "type": "string" },
        "contentHash": { "type": "string" }
      }
    },
    "FinancialSemanticClass": {
      "enum": [
        "ledgerFact",
        "envelopeAvailability",
        "cashFlowProjection",
        "advice",
        "proposal",
        "executionResult",
        "purchaseOutcome",
        "accountLiquidity",
        "reservation",
        "commitment",
        "sourceObservation",
        "normalizedEvidence",
        "economicEventResolution",
        "redactedConclusion"
      ]
    },
    "DecisionAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "scope", "amount"],
      "properties": {
        "label": { "$ref": "#/$defs/FinancialSemanticClass" },
        "scope": { "$ref": "#/$defs/DecisionScope" },
        "amount": { "$ref": "#/$defs/Money" }
      }
    },
    "DecisionSemanticState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amounts"],
      "properties": {
        "amounts": { "type": "array", "items": { "$ref": "#/$defs/DecisionAmount" } }
      }
    },
    "DecisionAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternativeId", "summary", "resultingState"],
      "properties": {
        "alternativeId": { "type": "string" },
        "summary": { "type": "string" },
        "resultingState": { "$ref": "#/$defs/DecisionSemanticState" }
      }
    },
    "ProspectiveDecisionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "decisionId",
        "decisionKind",
        "requestId",
        "correlationId",
        "context"
      ],
      "properties": {
        "contractVersion": { "type": "string" },
        "decisionId": { "type": "string" },
        "decisionKind": { "const": "purchase" },
        "requestId": { "type": "string" },
        "correlationId": { "type": "string" },
        "context": { "$ref": "#/$defs/DecisionContext" }
      }
    },
    "PurchaseEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowable",
        "reasonCodes",
        "categoryBudget",
        "categorySpent",
        "categoryRemaining",
        "projectedBalance"
      ],
      "properties": {
        "allowable": { "type": "boolean" },
        "reasonCodes": { "type": "array", "items": { "type": "string" } },
        "categoryBudget": { "$ref": "#/$defs/Money" },
        "categorySpent": { "$ref": "#/$defs/Money" },
        "categoryRemaining": { "$ref": "#/$defs/Money" },
        "projectedBalance": {
          "anyOf": [{ "$ref": "#/$defs/Money" }, { "type": "null" }]
        }
      }
    },
    "PurchaseProspectiveDecisionEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata",
        "readiness",
        "before",
        "after",
        "issues",
        "evidence",
        "alternatives",
        "expiresAt",
        "redaction",
        "payload"
      ],
      "properties": {
        "metadata": { "$ref": "#/$defs/ProspectiveDecisionMetadata" },
        "readiness": { "enum": ["ready", "qualified", "blocked"] },
        "before": { "$ref": "#/$defs/DecisionSemanticState" },
        "after": { "$ref": "#/$defs/DecisionSemanticState" },
        "issues": { "type": "array", "items": { "$ref": "#/$defs/DecisionIssue" } },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/EvidenceReference" } },
        "alternatives": { "type": "array", "items": { "$ref": "#/$defs/DecisionAlternative" } },
        "expiresAt": { "$ref": "#/$defs/CanonicalUtcTimestamp" },
        "redaction": { "enum": ["visible", "redacted"] },
        "payload": { "$ref": "#/$defs/PurchaseEvaluation" }
      }
    }
  }
}
