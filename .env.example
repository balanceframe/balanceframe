# =============================================================================
# BalanceFrame — production environment configuration
# =============================================================================
# Copy this file to .env and fill in your values before running Docker Compose.
#
#   cp .env.example .env
#   docker compose up -d
# =============================================================================

# Immutable image reference (set via release assets or CI).
# When using a published release, this should be a digest-pinned reference:
#   ghcr.io/balanceframe/balanceframe@sha256:<64-hex>
BALANCEFRAME_IMAGE_REF=

# Host port mapped to the BalanceFrame container (default: 3030).
BALANCEFRAME_PORT=3030

# Authentication secret (generate with: openssl rand -hex 32).
# This is required and must be kept secret in production.

# Bootstrap operator secret (choose exactly ONE for fresh instances):
#   BALANCEFRAME_BOOTSTRAP_SECRET_FILE  — path to a file containing the secret
#   BALANCEFRAME_BOOTSTRAP_SECRET       — inline environment variable
#
# For Docker Compose deployments, the project `compose.yaml` already configures
# `BALANCEFRAME_BOOTSTRAP_SECRET_FILE` pointing at the mounted secret.
# You only need to create the secret file on the host:
#
#   openssl rand -hex 32 > .bootstrap_secret
#
# Generate with: openssl rand -hex 32
# Required only while no owner account exists; may be removed afterward.
#BALANCEFRAME_BOOTSTRAP_SECRET_FILE=
#BALANCEFRAME_BOOTSTRAP_SECRET=
BETTER_AUTH_SECRET=

# Public URL of the BalanceFrame web application (for auth callbacks).
# Example: https://balanceframe.example.com or http://localhost:3030
BETTER_AUTH_URL=http://localhost:3030

# Actual Budget server connection.
# For a Docker-sidecar Actual on the same shared Docker network, the default
# value http://actual_server:5006 resolves via the service name.
# For an externally hosted Actual (PikaPods, Fly.io, LAN server, etc.), set
# the full URL:
#   ACTUAL_SERVER_URL=https://actual.example.com
ACTUAL_SERVER_URL=

# Actual Budget API password (the server-signoff password from Actual settings).
# Required.  Generate with: openssl rand -hex 32
ACTUAL_SECRET_KEY=
