{
  "name": "balanceframe",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for BalanceFrame — financial categorization using Actual Budget",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*",
    "crates/*"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "nitropack@2.13.4>archiver": "8.0.0"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ],
    "patchedDependencies": {
      "nitropack@2.13.4": "patches/nitropack@2.13.4.patch",
      "@nuxt/devtools@3.4.3": "patches/@nuxt__devtools@3.4.3.patch",
      "@actual-app/api@26.10.0": "patches/@actual-app__api@26.10.0.patch",
      "node-forge@1.4.0": "patches/node-forge@1.4.0.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "scenarios": "pnpm --filter @balanceframe/scenario-kit build && node packages/scenario-kit/dist/scenario-kit/src/cli.js",
    "demo": "pnpm scenarios run",
    "test": "pnpm test:dependency-security && pnpm -r test",
    "test:dependency-security": "node --test --test-concurrency=1 tests/dependency-security/*.test.mjs",
    "coverage": "bash scripts/coverage/run.sh",
    "test:coverage-gates": "node --test scripts/coverage/check.test.mjs scripts/coverage/run.test.mjs",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
