{
  "name": "balanceframe",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Monorepo for BalanceFrame — financial categorization using Actual Budget",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*",
    "crates/*"
  ],
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0",
    "pnpm": "10.x"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "overrides": {
      "nitropack": "2.13.6",
      "@nuxt/devtools": "3.4.4",
      "@tailwindcss/postcss@4.3.3>postcss": "8.5.23",
      "browserslist@4.28.7>baseline-browser-mapping": "2.11.0",
      "fast-uri": "3.1.9",
      "brace-expansion": "5.0.12",
      "serialize-javascript": "7.1.3",
      "node-forge": "1.4.3",
      "@nuxt/kit": "4.6.4",
      "@nuxt/schema": "4.6.4",
      "js-beautify@2.0.3>glob": "14.0.6",
      "fontless@0.2.1>esbuild": "0.28.2"
    },
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "vue-demi"
    ],
    "patchedDependencies": {
      "@actual-app/api@26.10.0": "patches/@actual-app__api@26.10.0.patch",
      "braces@3.0.3": "patches/braces@3.0.3.patch",
      "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch",
      "minimatch@10.2.5": "patches/minimatch@10.2.5.patch"
    }
  },
  "scripts": {
    "build": "pnpm -r build",
    "scenarios": "pnpm --filter @balanceframe/scenario-kit build && node packages/scenario-kit/dist/scenario-kit/src/cli.js",
    "demo": "pnpm scenarios run",
    "test": "pnpm test:dependency-security && pnpm -r test",
    "test:dependency-security": "node --test --test-concurrency=1 tests/dependency-security/*.test.mjs",
    "coverage": "bash scripts/coverage/run.sh",
    "test:coverage-gates": "node --test scripts/coverage/check.test.mjs scripts/coverage/run.test.mjs",
    "lint": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
